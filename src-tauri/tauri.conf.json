{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deja",
  "version": "0.1.0",
  "identifier": "dev.deja.viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Deja",
        "width": 1100,
        "height": 780,
        "minWidth": 560,
        "minHeight": 400,
        "resizable": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 7, "y": 20.5 },
        "hiddenTitle": true,
        "backgroundColor": "#1b1b1d"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "djvu",
          "djv"
        ],
        "name": "DjVu Document",
        "description": "DjVu scanned document",
        "role": "Viewer"
      }
    ]
  }
}
